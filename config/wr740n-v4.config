# diffconfig para TL-WR740N v4 (AR9331, 4 MB flash / 32 MB RAM)
# O workflow aplica isto sobre o OpenWrt e roda "make defconfig".
# O perfil tem DEFAULT:=n no OpenWrt (os builders oficiais pulam), por isso
# precisa ser selecionado explicitamente aqui.

CONFIG_TARGET_ath79=y
CONFIG_TARGET_ath79_tiny=y
CONFIG_TARGET_ath79_tiny_DEVICE_tplink_tl-wr740n-v4=y

# --- Portal cativo ---
CONFIG_PACKAGE_nodogsplash=y

# --- Cortes para caber em 3904 KB ---
# Sem PPPoE (WAN por DHCP/estatico). Se precisar de PPPoE, remova estas 3 linhas
# e verifique o tamanho da imagem.
# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_ppp-mod-pppoe is not set
# CONFIG_PACKAGE_kmod-ppp is not set
# Sem IPv6
# CONFIG_IPV6 is not set
# CONFIG_PACKAGE_odhcp6c is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
# CONFIG_PACKAGE_ip6tables is not set
# CONFIG_PACKAGE_kmod-ip6tables is not set
# CONFIG_PACKAGE_kmod-nf-ipt6 is not set
# CONFIG_PACKAGE_kmod-ipv6 is not set
# Sem opkg/gerenciador de pacotes na imagem final nao e possivel remover com
# seguranca no 24.10; mantido.
